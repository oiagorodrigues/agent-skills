# Generated by bin/retro-hook.py (session retros, logs). Private.
/retros/

# Private material that stays on this machine: company workspace skills (ws-<name>) and the per-machine
# .link-skip files, which name local profile folders. link-skills.sh still links and reads them.
skills/ws-*/
skills/*/.link-skip
# A private study kept outside this repo; ignored in case it comes back. Anchored, because some skills have their own agents/ folder.
/agents/

# Factory: per-ticket run folders, check caches and the local config copied from config.example.json.
factory/runs/
factory/cache/
factory/.cache/
factory/config.json

# npx skills CLI backup; .skill-lock.json itself is tracked.
.skill-lock.json.backup
*.backup
*.bak

# Python
__pycache__/
*.pyc
.venv/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# Node
node_modules/

# OS and editors
.DS_Store
*.swp
.idea/
.vscode/
