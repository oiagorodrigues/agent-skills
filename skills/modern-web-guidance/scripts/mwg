#!/usr/bin/env bash
# Runs the vendored modern-web-guidance CLI offline, with telemetry off.
# Usage: mwg search "<query>" | mwg list | mwg retrieve "<id>[,<id>...]"
set -euo pipefail

script_dir="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd -P)"
cli="$script_dir/../vendor/modern-web-guidance/skills/modern-web-guidance/modern-web.mjs"

if ! command -v node >/dev/null 2>&1; then
  echo "mwg: node is not on PATH. Install Node.js 22 or newer." >&2
  exit 127
fi

# The package declares engines.node >=22.
node_major="$(node -p 'process.versions.node.split(".")[0]')"
if [ "$node_major" -lt 22 ]; then
  echo "mwg: Node.js 22 or newer is required, found $(node --version)." >&2
  exit 1
fi

if [ ! -f "$cli" ]; then
  echo "mwg: vendored CLI not found at $cli. See vendor/README.md to restore it." >&2
  exit 1
fi

case "${1:-}" in
  install | update | uninstall)
    # These shell out to `npx skills ...`, which downloads from the network.
    echo "mwg: '$1' is disabled in the offline copy. Use search, list or retrieve." >&2
    exit 2
    ;;
esac

# DISABLE_TELEMETRY=1 stops the CLI from starting its telemetry process
# (watchdog/main.js), which posts to play.googleapis.com.
export DISABLE_TELEMETRY=1

exec node "$cli" "$@"
